rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isMember(groupData) { return isSignedIn() && request.auth.uid in groupData.memberIds; }

    // ---- users ----
    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // ---- invite code -> groupId lookup ----
    match /inviteCodes/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false; // codes are permanent once issued
    }

    // ---- groups ----
    match /groups/{groupId} {
      allow read: if isMember(resource.data);
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.memberIds;

      // members can update group settings (name/emoji/currency).
      // non-members can ONLY self-join: this update must add exactly the
      // caller's own uid to memberIds and nothing else structurally breaking.
      allow update: if isMember(resource.data) ||
        (
          isSignedIn() &&
          !(request.auth.uid in resource.data.memberIds) &&
          request.auth.uid in request.resource.data.memberIds &&
          request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        );

      allow delete: if false; // circles are kept forever

      // ---- expenses (soft-delete only, never hard-deleted) ----
      match /expenses/{expenseId} {
        allow read: if isMember(get(/databases/$(database)/documents/groups/$(groupId)).data);
        allow create, update: if isMember(get(/databases/$(database)/documents/groups/$(groupId)).data);
        allow delete: if false;
      }

      // ---- activity log: append-only audit trail ----
      match /activity/{entryId} {
        allow read: if isMember(get(/databases/$(database)/documents/groups/$(groupId)).data);
        allow create: if isMember(get(/databases/$(database)/documents/groups/$(groupId)).data);
        allow update, delete: if false; // immutable â€” this is what prevents disputes
      }
    }
  }
}
